---
import data from '../data/github.json';
import { Image } from 'astro:assets';
import logo from '../../public/assets/privylock-logo.png';
import { withBase } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase()} aria-label="PrivyLock home"><Image src={logo} width={32} height={32} densities={[1, 2]} alt="" />PrivyLock</a>
    <nav aria-label="Main navigation">
      <a href={withBase('docs/')} aria-current={path.includes('/docs') ? 'page' : undefined}>Docs</a>
      <a href={withBase('releases/')} aria-current={path.includes('/releases') ? 'page' : undefined}>Releases</a>
      <a class="github-link" href={data.repository.url}><span data-star-count>{data.repository.stars}</span> <span data-star-label>{data.repository.stars === 1 ? 'star' : 'stars'}</span> on GitHub</a>
    </nav>
  </div>
</header>
<script>
  const key = 'privylock-github-stars-v1';
  function render(stars: number) {
    document.querySelectorAll('[data-star-count]').forEach(el => el.textContent = stars.toLocaleString());
    document.querySelectorAll('[data-star-label]').forEach(el => el.textContent = stars === 1 ? 'star' : 'stars');
  }
  async function updateStars() {
    try {
      const cached = JSON.parse(sessionStorage.getItem(key) || 'null');
      if (cached && Number.isSafeInteger(cached.stars) && cached.stars >= 0 && Date.now() - cached.at < 300000) { render(cached.stars); return; }
    } catch { /* Storage may be disabled. */ }
    try {
      const response = await fetch('https://api.github.com/repos/apil-khadka/PrivyLock', { signal: AbortSignal.timeout(8000), headers: { Accept: 'application/vnd.github+json' } });
      if (!response.ok) return;
      const repo = await response.json();
      if (repo.full_name !== 'apil-khadka/PrivyLock' || !Number.isSafeInteger(repo.stargazers_count) || repo.stargazers_count < 0) return;
      render(repo.stargazers_count);
      try { sessionStorage.setItem(key, JSON.stringify({ stars: repo.stargazers_count, at: Date.now() })); } catch { /* The static count remains available. */ }
    } catch { /* Keep the build-time count when GitHub is unavailable. */ }
  }
  void updateStars();
</script>
