---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import logo from '../../public/assets/privylock-logo.png';
import CodeBlock from '../components/CodeBlock.astro';
import data from '../data/github.json';
import { latestStable } from '../lib/github.mjs';
import { withBase } from '../lib/site';
const release = latestStable(data.releases);
---
<SiteLayout>
  <main id="main">
    <section class="container hero">
      <div class="hero-copy"><p class="eyebrow">A little more privacy on your Mac</p><h1>Your apps.<br />Your permission.</h1><p class="lead">Keep selected apps closed until you unlock them with Touch ID or your Mac password. PrivyLock lives quietly in your menu bar.</p><div class="actions">{release?.downloadURL && <a class="button" href={release.downloadURL}>Download {release.tag}</a>}<a class="button button-secondary" href={withBase('docs/getting-started/')}>Get started</a></div><p class="fine-print">macOS 12 or later. Apple Silicon and Intel.<br />Ad-hoc signed; first launch may need macOS approval.</p></div>
      <figure class="app-preview"><div class="preview-label"><Image src={logo} width={28} height={28} densities={[1, 2]} alt="" /><span>A native macOS utility</span></div><img class="app-window" src={withBase('assets/app-window.png')} width="940" height="860" alt="PrivyLock management window showing protected apps and lock controls" fetchpriority="high" /><figcaption>A management preview with example apps.</figcaption></figure>
    </section>
    <section class="container feature-grid" aria-label="Product features">
      <article class="feature feature-thistle"><span class="feature-number">01</span><h2>Choose what stays private</h2><p>Add desktop apps to your protected list. Lock one app or manage several together.</p></article>
      <article class="feature feature-blue"><span class="feature-number">02</span><h2>Authenticate with macOS</h2><p>Use the system Touch ID or Mac password prompt. PrivyLock never receives your credentials.</p></article>
      <article class="feature feature-pink"><span class="feature-number">03</span><h2>Keep protection nearby</h2><p>Menu bar controls, saved settings, automatic locking, and optional startup at login.</p></article>
    </section>
    <section class="container overview-grid">
      <div><p class="eyebrow">How it works</p><h2>Three steps to a protected app</h2><ol class="steps"><li><strong>Add an app.</strong> Choose an installed app from PrivyLock.</li><li><strong>Save your work, then lock.</strong> PrivyLock closes the app and stops it if it relaunches.</li><li><strong>Unlock when you need it.</strong> Authenticate, then open the app again.</li></ol><a class="text-link" href={withBase('docs/getting-started/')}>Read the setup guide →</a></div>
      <div class="install-panel"><h2>Install with Homebrew</h2><p>Install the universal macOS build from the maintained tap.</p><CodeBlock code={'brew tap apil-khadka/tap\nbrew install --cask privylock\nopen -a PrivyLock'} /><a href={withBase('docs/troubleshooting/')}>First launch help →</a></div>
    </section>
    <section class="container security-note"><h2>Understand the protection</h2><p>PrivyLock closes locked apps after they start. It is a privacy convenience tool: it does not isolate files, notifications, or processes, and someone with access to your Mac account can stop it. Locking can discard unsaved work.</p><a href={withBase('docs/security/')}>Read the security model →</a></section>
    <section class="container latest-section"><div><p class="eyebrow">Keep up with PrivyLock</p><h2>{release ? `${release.tag} is available` : 'Follow the next release'}</h2><p>{release ? 'Release notes, downloads, and checksums are collected in one place.' : 'Published releases will appear here automatically.'}</p></div><a class="button button-secondary" href={withBase('releases/')}>Explore releases →</a></section>
  </main>
</SiteLayout>
